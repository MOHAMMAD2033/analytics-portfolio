{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "visual5",
  "position": {
    "x": 20,
    "y": 250,
    "z": 4,
    "height": 520,
    "width": 610,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimYear"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "DimYear.Year",
              "nativeQueryRef": "Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Population"
                    }
                  },
                  "Property": "Annual Population"
                }
              },
              "queryRef": "Population.Annual Population",
              "nativeQueryRef": "Annual Population"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "DimYear"
                  }
                },
                "Property": "Year"
              }
            },
            "direction": "Ascending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Population trend'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}