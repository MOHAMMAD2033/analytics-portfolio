{
  "name": "SaudiPopulation",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Population",
        "columns": [
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "RegionCode",
            "dataType": "int64",
            "sourceColumn": "RegionCode",
            "summarizeBy": "none"
          },
          {
            "name": "Population",
            "dataType": "int64",
            "sourceColumn": "Population",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Population",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"Year\", \"RegionCode\", \"Population\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Year\", Int64.Type}, {\"RegionCode\", Int64.Type}, {\"Population\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Population Latest Year",
            "expression": "VAR LastYear = MAX(DimYear[Year]) RETURN CALCULATE(SUM(Population[Population]), DimYear[Year] = LastYear)",
            "formatString": "#,0"
          },
          {
            "name": "Regions",
            "expression": "DISTINCTCOUNT(Population[RegionCode])",
            "formatString": "0"
          },
          {
            "name": "Latest Year",
            "expression": "MAX(DimYear[Year])",
            "formatString": "0"
          },
          {
            "name": "Population 2010",
            "expression": "CALCULATE(SUM(Population[Population]), REMOVEFILTERS(DimYear), DimYear[Year] = 2010)",
            "formatString": "#,0"
          },
          {
            "name": "Growth Since 2010",
            "expression": "DIVIDE([Population Latest Year] - [Population 2010], [Population 2010])",
            "formatString": "0.0%"
          },
          {
            "name": "Annual Population",
            "expression": "SUM(Population[Population])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "DimRegion",
        "columns": [
          {
            "name": "RegionCode",
            "dataType": "int64",
            "sourceColumn": "RegionCode",
            "summarizeBy": "none"
          },
          {
