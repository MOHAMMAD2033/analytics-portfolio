                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"JcyxEQAgCATBhgzgVdRaGPpvw9GLNttMmVu1h4Ogw4AJAQs2nI9YxCJVXQ==\", BinaryEncoding.Base64), Compression.Deflate)), {\"Year\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Year\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "759ac1c2-aaea-56a4-9fd1-c8a14572931b",
