            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimRegion",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"Vc7NCsIwEATgV5E9r2Ctv8cKghQsWLyFHEYaTUxtIG0P+vQmqRdv8y2zMEJkTLV5o9EkWSyZzrAWCXlEY7pJK6YLeqVeEWumI/pB+W5Wq4dxXTxumIpQ8DFvma64udFG7JhOMG2Me6bK+UH/f2YLphIfTAiLKjz9T2FS0c4P0EjME0s33knKLw==\", BinaryEncoding.Base64), Compression.Deflate)), {\"RegionCode\", \"Region\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"RegionCode\", Int64.Type}, {\"Region\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DimYear",
        "columns": [
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimYear",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
