{
  "name": "RFM",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Customers",
        "columns": [
          {
            "name": "CustomerId",
            "dataType": "string",
            "sourceColumn": "CustomerId",
            "summarizeBy": "none"
          },
          {
            "name": "RecencyDays",
            "dataType": "int64",
            "sourceColumn": "RecencyDays",
            "summarizeBy": "sum"
          },
          {
            "name": "Frequency",
            "dataType": "int64",
            "sourceColumn": "Frequency",
            "summarizeBy": "sum"
          },
          {
            "name": "Monetary",
            "dataType": "double",
            "sourceColumn": "Monetary",
            "summarizeBy": "sum"
          },
          {
            "name": "Profit",
            "dataType": "double",
            "sourceColumn": "Profit",
            "summarizeBy": "sum"
          },
          {
            "name": "RScore",
            "dataType": "int64",
            "sourceColumn": "RScore",
            "summarizeBy": "sum"
          },
          {
            "name": "FScore",
            "dataType": "int64",
            "sourceColumn": "FScore",
            "summarizeBy": "sum"
          },
          {
            "name": "MScore",
            "dataType": "int64",
            "sourceColumn": "MScore",
            "summarizeBy": "sum"
          },
          {
            "name": "Segment",
            "dataType": "string",
            "sourceColumn": "Segment",
            "summarizeBy": "none"
          },
          {
            "name": "SnapshotDate",
            "dataType": "string",
            "sourceColumn": "SnapshotDate",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"CustomerId\", \"RecencyDays\", \"Frequency\", \"Monetary\", \"Profit\", \"RScore\", \"FScore\", \"MScore\", \"Segment\", \"SnapshotDate\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"CustomerId\", type text}, {\"RecencyDays\", Int64.Type}, {\"Frequency\", Int64.Type}, {\"Monetary\", type number}, {\"Profit\", type number}, {\"RScore\", Int64.Type}, {\"FScore\", Int64.Type}, {\"MScore\", Int64.Type}, {\"Segment\", type text}, {\"SnapshotDate\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Customers",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0"
          },
          {
            "name": "Historical Sales",
            "expression": "SUM(Customers[Monetary])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Average Recency",
            "expression": "AVERAGE(Customers[RecencyDays])",
            "formatString": "0.0"
          },
          {
            "name": "Average Frequency",
            "expression": "AVERAGE(Customers[Frequency])",
            "formatString": "0.0"
          },
          {
            "name": "Historical Profit",
            "expression": "SUM(Customers[Profit])",
            "formatString": "$#,0.00"
          }
        ]
      }
    ],
    "relationships": [],
    "dataSourceDefaultVersion": "powerBI_V3"
  }
}