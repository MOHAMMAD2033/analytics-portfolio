            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"RowId\", \"OrderId\", \"CustomerId\", \"ProductId\", \"Region\", \"Sales\", \"Profit\", \"Quantity\", \"Discount\", \"ShippingDays\", \"DateKey\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"RowId\", Int64.Type}, {\"OrderId\", type text}, {\"CustomerId\", type text}, {\"ProductId\", type text}, {\"Region\", type text}, {\"Sales\", type number}, {\"Profit\", type number}, {\"Quantity\", Int64.Type}, {\"Discount\", type number}, {\"ShippingDays\", Int64.Type}, {\"DateKey\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Sales[Sales])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(Sales[Profit])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Profit Margin",
            "expression": "DIVIDE([Total Profit], [Total Sales])",
            "formatString": "0.00%"
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT(Sales[OrderId])",
            "formatString": "#,0"
          },
          {
            "name": "Customers",
            "expression": "DISTINCTCOUNT(Sales[CustomerId])",
            "formatString": "#,0"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Total Sales], [Orders])",
            "formatString": "$#,0.00"
          }
        ]
